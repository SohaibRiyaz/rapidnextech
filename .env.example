# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- Site ---
# Canonical origin used for sitemap, robots and JSON-LD URLs.
NEXT_PUBLIC_BASE_URL=https://rapidnextech.com

# --- Supabase (blog, case studies, partners, admin CMS) ---
# The build fails without these two (lib/supabase.ts throws when they are missing).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/ai-blog-image (admin tooling).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Existing key, already used by /api/contact and /api/stripe-intent.
# Also used by /api/pilot-request. The sender domain rapidnextech.com must be verified in Resend.
RESEND_API_KEY=
# Where new dental pilot requests are emailed (server-only). Required for the pilot form.
LEAD_NOTIFY_EMAIL=sohaibriaz201@gmail.com
# Reply-to on the confirmation email sent to the practice. Optional; defaults to contact@rapidnextech.com.
CONFIRMATION_REPLY_TO=

# --- Analytics (all optional; nothing loads when unset) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Custom events are routed to GA4 when set.
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project ID (session recordings). Pilot form inputs are masked.
NEXT_PUBLIC_CLARITY_ID=
# Search console verification tokens (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Admin AI blog tooling (existing) ---
# Note: NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_GROQ_API_KEY=
NEXT_PUBLIC_HUGGINGFACE_TOKEN=

# --- Retell voice demo (dental #live-demo section and /api/retell-webhook) ---
# Server-only. Must be the Retell API key with the "webhook" badge: it verifies x-retell-signature
# on /api/retell-webhook. Never prefix with NEXT_PUBLIC_ and never commit it.
RETELL_API_KEY=
# Public key from Retell (API Keys > Public Keys). Safe in the browser: it only works from the domains
# allow-listed on the key in the Retell dashboard. Starts browser web calls.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
# The dental demo agent ("Maya").
NEXT_PUBLIC_RETELL_AGENT_ID=agent_4c46945b0c6795c5c1e20e33a6
# Published agent version to use, so draft edits in Retell never reach the live site. Bump after publishing.
NEXT_PUBLIC_RETELL_AGENT_VERSION=4
# reCAPTCHA v3 SITE key (public). The secret key is entered in the Retell dashboard on the public key,
# not here. Optional: when unset, calls start without a token (only works if reCAPTCHA is off in Retell).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
